  "l3_assertion_rules": {
    "receipt_no_motion":{"allow":"응답/무응답은 수신·의사 상태만 변경","forbid":"차량 pose 변경, action completed, 사건 해결","checks":["vehicle_pose_equals_initial","no_completed_movement","no_resolution_claim"]},
    "delayed_will_move":{"allow":"명시 지연 기한 전 pose 불변, 이후 지원 경로에서 이동 시작","forbid":"기한 전 순간 이동 또는 중복 행동","checks":["at_tick_9_pose_equals_initial","action_queued_at_tick_9","movement_only_after_deadline"]},
    "mid_route_obstacle":{"allow":"접촉 전 blocked로 멈추고 제거 후에도 원 행동 자동 재개 없음","forbid":"접촉·안전하지 않은 pose·자동 재개","checks":["blocked_before_contact","pose_safe","pose_unchanged_after_obstacle_removed"]},
    "explicit_retry_s1b":{"allow":"새 명시 will_move 입력 후 지원 S1-b 경로만 완료","forbid":"원 blocked 행동 재개 또는 중복 실행","checks":["original_action_stays_blocked","new_action_completed","final_b_pose_x_27_y_21_7"]},
    "explicit_retry_s1c":{"allow":"중간 pose에서 지원하지 않는 재주차는 blocked 유지","forbid":"새 경로 임의 생성·중간 pose 이동","checks":["original_action_stays_blocked","new_action_blocked","pose_unchanged"]},
    "one_channel_alarm":{"allow":"확인된 한 채널만으로 합성 제동, 실패 채널은 실패로 기록","forbid":"실패 채널 성공 주장·합성 제동을 현실 안전 보장으로 주장","checks":["failed_channel_failed","working_channel_on","synthetic_brake","no_synthetic_contact"]},
    "failed_announcement":{"allow":"방송 접수와 재생 실패 분리, 입차 제한 보류, 독립 출차 허용","forbid":"재생 실패 뒤 입차 제한·브라우저 음향 성공 주장","checks":["broadcast_receipt_accepted","simulated_playback_failed","browser_playback_not_requested","entry_policy_allow","exit_open_and_vehicle_exited"]},
    "pending_restart":{"allow":"pending action 보존·복구 필요 중 정지, 명시 복구 뒤 기존 한 행동만 진행","forbid":"복구 전 이동·행동 중복 생성","checks":["recovery_required","pose_still_before_explicit_resume","one_action_after_resume","original_apply_tick_preserved"]},
    "unknown_gate_restart":{"allow":"unknown 결과와 원 operation ID 보존·기존 실행 조회, blind retry held, 출차 열림","forbid":"unknown을 성공/취소로 꾸밈·중복 닫기","checks":["unknown_preserved","original_operation_count_one","blind_retry_held","exit_open","browser_playback_not_requested"]}
