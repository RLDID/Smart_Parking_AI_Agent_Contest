{
  "create_or_update_incident": {
    "$defs": {
      "IncidentImpact": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "aisle_obstruction",
              "exit_blocked",
              "bay_intrusion",
              "approach_risk"
            ],
            "title": "Type",
            "type": "string"
          },
          "object_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Object Id"
          },
          "zone_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Zone Id",
            "type": "string"
          },
          "condition_json": {
            "additionalProperties": true,
            "title": "Condition Json",
            "type": "object"
          }
        },
        "required": [
          "type",
          "zone_id"
        ],
        "title": "IncidentImpact",
        "type": "object"
      },
      "KnowledgeEvidence": {
        "additionalProperties": false,
        "properties": {
          "retrieval_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Retrieval Id",
            "type": "string"
          },
          "reference_ids": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Reference Ids",
            "type": "array"
          }
        },
        "required": [
          "retrieval_id",
          "reference_ids"
        ],
        "title": "KnowledgeEvidence",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "facility_id": {
        "maxLength": 128,
        "minLength": 1,
        "title": "Facility Id",
        "type": "string"
      },
      "run_id": {
        "maxLength": 128,
        "minLength": 1,
        "title": "Run Id",
        "type": "string"
      },
      "based_on_state_version": {
        "minimum": 0,
        "title": "Based On State Version",
        "type": "integer"
      },
      "policy_version": {
        "minimum": 1,
        "title": "Policy Version",
        "type": "integer"
      },
      "incident_id": {
        "anyOf": [
          {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Incident Id"
      },
      "command_id": {
        "anyOf": [
          {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Command Id"
      },
      "plan_id": {
        "anyOf": [
          {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Plan Id"
      },
      "knowledge_evidence": {
        "anyOf": [
          {
            "$ref": "#/$defs/KnowledgeEvidence"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "primary_object_id": {
        "maxLength": 128,
        "minLength": 1,
        "title": "Primary Object Id",
        "type": "string"
      },
      "status": {
        "enum": [
          "candidate",
          "active",
          "monitoring",
          "needs_review",
          "escalated",
          "resolved",
          "closed_no_issue",
          "closed_false_positive"
        ],
        "title": "Status",
        "type": "string"
      },
      "impacts": {
        "items": {
          "$ref": "#/$defs/IncidentImpact"
        },
        "minItems": 1,
        "title": "Impacts",
        "type": "array"
      },
      "evidence_ids": {
        "items": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 64,
        "minItems": 1,
        "title": "Evidence Ids",
        "type": "array"
      },
      "reason_summary": {
        "maxLength": 1000,
        "minLength": 1,
        "title": "Reason Summary",
        "type": "string"
      },
      "expected_resource_version": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expected Resource Version"
      }
    },
    "required": [
      "facility_id",
      "run_id",
      "based_on_state_version",
      "policy_version",
      "primary_object_id",
      "status",
      "impacts",
      "evidence_ids",
      "reason_summary"
    ],
    "title": "IncidentInput",
    "type": "object"
  },
