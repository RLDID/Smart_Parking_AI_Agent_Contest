        ],
        "default": null,
        "title": "Plan Id"
      },
      "knowledge_evidence": {
        "anyOf": [
          {
            "$ref": "#/$defs/KnowledgeEvidence"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "recipient_ref": {
        "maxLength": 128,
        "minLength": 1,
        "title": "Recipient Ref",
        "type": "string"
      },
      "purpose": {
        "const": "move_request",
        "default": "move_request",
        "title": "Purpose",
        "type": "string"
      },
      "template_id": {
        "const": "move_request_v1",
        "default": "move_request_v1",
        "title": "Template Id",
        "type": "string"
      },
      "template_args": {
        "$ref": "#/$defs/MoveTemplateArgs"
      },
      "contact_sequence": {
        "minimum": 1,
        "title": "Contact Sequence",
        "type": "integer"
      },
      "expected_resource_version": {
        "minimum": 1,
        "title": "Expected Resource Version",
        "type": "integer"
      }
    },
    "required": [
      "facility_id",
      "run_id",
      "based_on_state_version",
      "policy_version",
      "recipient_ref",
      "template_args",
      "contact_sequence",
      "expected_resource_version"
    ],
    "title": "NotifyVehicle",
    "type": "object"
  },
