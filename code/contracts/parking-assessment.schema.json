{
  "$defs": {
    "BayGeometryAnalysis": {
      "additionalProperties": false,
      "properties": {
        "analysis_version": {
          "const": "s1c-bay-footprint-v1",
          "default": "s1c-bay-footprint-v1",
          "title": "Analysis Version",
          "type": "string"
        },
        "facility_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Facility Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "map_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Map Version",
          "type": "string"
        },
        "map_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Map Digest"
        },
        "observation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "state_version": {
          "minimum": 0,
          "title": "State Version",
          "type": "integer"
        },
        "evaluated_at_sim_time_ms": {
          "minimum": 0,
          "title": "Evaluated At Sim Time Ms",
          "type": "integer"
        },
        "analyzed_at": {
          "title": "Analyzed At",
          "type": "string"
        },
        "object_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "bay_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Bay Id",
          "type": "string"
        },
        "support_status": {
          "enum": [
            "supported",
            "insufficient_data",
            "unsupported_geometry"
          ],
          "title": "Support Status",
          "type": "string"
        },
        "geometry_relation": {
          "enum": [
            "within",
            "overlap",
            "unknown"
          ],
          "title": "Geometry Relation",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "nominal_outside_area_m2": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nominal Outside Area M2"
        },
        "outside_area_lower_bound_m2": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outside Area Lower Bound M2"
        },
        "outside_area_upper_bound_m2": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outside Area Upper Bound M2"
        },
        "nominal_max_depth_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nominal Max Depth M"
        },
        "max_depth_lower_bound_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Depth Lower Bound M"
        },
        "max_depth_upper_bound_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Depth Upper Bound M"
        },
        "adjacent_bay_overlap_m2": {
          "additionalProperties": {
            "$ref": "#/$defs/BayOverlapArea"
          },
          "title": "Adjacent Bay Overlap M2",
          "type": "object"
        },
        "applied_tolerance_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applied Tolerance M"
        },
        "position_uncertainty_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position Uncertainty M"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "facility_id",
        "run_id",
        "map_version",
        "map_digest",
        "observation_id",
        "state_version",
        "evaluated_at_sim_time_ms",
        "analyzed_at",
        "object_id",
        "bay_id",
        "support_status",
        "geometry_relation",
        "reasons",
        "assumptions"
      ],
      "title": "BayGeometryAnalysis",
      "type": "object"
    },
    "BayGeometrySettings": {
      "additionalProperties": false,
      "properties": {
        "tolerance_m": {
          "maximum": 100.0,
          "minimum": 0,
          "title": "Tolerance M",
          "type": "number"
        },
        "max_uncertainty_m": {
          "maximum": 100.0,
          "minimum": 0,
          "title": "Max Uncertainty M",
          "type": "number"
        },
        "freshness_ms": {
          "exclusiveMinimum": 0,
          "maximum": 86399999913600000,
          "title": "Freshness Ms",
          "type": "integer"
        }
      },
      "required": [
        "tolerance_m",
        "max_uncertainty_m",
        "freshness_ms"
      ],
      "title": "BayGeometrySettings",
      "type": "object"
    },
    "BayOverlapArea": {
      "additionalProperties": false,
      "properties": {
        "nominal_m2": {
          "minimum": 0,
          "title": "Nominal M2",
          "type": "number"
        },
        "lower_bound_m2": {
          "minimum": 0,
          "title": "Lower Bound M2",
          "type": "number"
        },
        "upper_bound_m2": {
          "minimum": 0,
          "title": "Upper Bound M2",
          "type": "number"
        }
      },
      "required": [
        "nominal_m2",
        "lower_bound_m2",
        "upper_bound_m2"
      ],
      "title": "BayOverlapArea",
      "type": "object"
    },
    "ParkingAssessmentSettings": {
      "additionalProperties": false,
      "properties": {
        "geometry": {
          "$ref": "#/$defs/BayGeometrySettings"
        },
        "stationary_ms": {
          "exclusiveMinimum": 0,
          "maximum": 86400000,
          "title": "Stationary Ms",
          "type": "integer"
        },
        "position_tolerance_m": {
          "maximum": 100,
          "minimum": 0,
          "title": "Position Tolerance M",
          "type": "number"
        },
        "heading_tolerance_deg": {
          "maximum": 180,
          "minimum": 0,
          "title": "Heading Tolerance Deg",
          "type": "number"
        },
        "maneuver_grace_ms": {
          "maximum": 86400000,
          "minimum": 0,
          "title": "Maneuver Grace Ms",
          "type": "integer"
        },
        "intrusion_hold_ms": {
          "exclusiveMinimum": 0,
          "maximum": 86400000,
          "title": "Intrusion Hold Ms",
          "type": "integer"
        },
        "max_sample_gap_ms": {
          "exclusiveMinimum": 0,
          "maximum": 60000,
          "title": "Max Sample Gap Ms",
          "type": "integer"
        },
        "history_limit": {
          "maximum": 512,
          "minimum": 2,
          "title": "History Limit",
          "type": "integer"
        }
      },
      "required": [
        "geometry",
        "stationary_ms",
        "position_tolerance_m",
        "heading_tolerance_deg",
        "maneuver_grace_ms",
        "intrusion_hold_ms",
        "max_sample_gap_ms",
        "history_limit"
      ],
      "title": "ParkingAssessmentSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_version": {
      "const": "s1c-parking-history-v1",
      "default": "s1c-parking-history-v1",
      "title": "Analysis Version",
      "type": "string"
    },
    "facility_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Facility Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "map_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Map Version",
      "type": "string"
    },
    "object_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Object Id",
      "type": "string"
    },
    "bay_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Bay Id",
      "type": "string"
    },
    "state_version": {
      "minimum": 0,
      "title": "State Version",
      "type": "integer"
    },
    "evaluated_at_sim_time_ms": {
      "minimum": 0,
      "title": "Evaluated At Sim Time Ms",
      "type": "integer"
    },
    "analyzed_at": {
      "title": "Analyzed At",
      "type": "string"
    },
    "support_status": {
      "enum": [
        "supported",
        "insufficient_data",
        "unsupported_geometry"
      ],
      "title": "Support Status",
      "type": "string"
    },
    "observation_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Observation Ids",
      "type": "array"
    },
    "motion_state": {
      "enum": [
        "stationary_candidate",
        "moving",
        "insufficient_history",
        "unknown"
      ],
      "title": "Motion State",
      "type": "string"
    },
    "stationary_duration_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stationary Duration Ms"
    },
    "intrusion_state": {
      "enum": [
        "within_tolerance",
        "transient_or_maneuver",
        "persistent_candidate",
        "unknown"
      ],
      "title": "Intrusion State",
      "type": "string"
    },
    "intrusion_duration_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intrusion Duration Ms"
    },
    "geometry": {
      "$ref": "#/$defs/BayGeometryAnalysis"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "applied_settings": {
      "$ref": "#/$defs/ParkingAssessmentSettings"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    }
  },
  "required": [
    "facility_id",
    "run_id",
    "map_version",
    "object_id",
    "bay_id",
    "state_version",
    "evaluated_at_sim_time_ms",
    "analyzed_at",
    "support_status",
    "observation_ids",
    "motion_state",
    "intrusion_state",
    "geometry",
    "reasons",
    "applied_settings",
    "assumptions"
  ],
  "title": "ParkingAssessment",
  "type": "object"
}
