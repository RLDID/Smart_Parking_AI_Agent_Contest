{
  "name": "parkline-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "dev:integration": "vite --host 127.0.0.1 --port 8000 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/publish-preview.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test": "node --experimental-strip-types --test ../../tests/frontend-model.test.mts tests/*.test.mts"
  },
  "dependencies": { "react": "19.3.0", "react-dom": "19.3.0" },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
